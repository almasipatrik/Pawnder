# ============================================================================
# Pawnder – Environment Variables Example
# Copy this file to .env and customize for local dev or production
# ============================================================================

# --- PostgreSQL / AWS RDS Database ---
# Local Docker Postgres:
DATABASE_URL=postgresql://pawnder:pawnder@localhost:5432/pawnder
DATABASE_SSL=false

# Example AWS RDS PostgreSQL connection:
# DATABASE_URL=postgresql://postgres:YOUR_RDS_PASSWORD@your-rds-instance.abcdefghijkl.eu-central-1.rds.amazonaws.com:5432/pawnder
# DATABASE_SSL=true

# --- Backend (NestJS) ---
PORT=3000
JWT_SECRET=change-this-secret-in-production-min-32-chars
FRONTEND_URL=http://localhost:3001
SCRAPER_API_KEY=optional-secret-key-for-manual-sync-endpoint

# --- Email (SMTP / Mailpit / AWS SES) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pawnder <noreply@pawnder.hu>"

# --- Background Scraper Worker ---
SCRAPER_CRON_ENABLED=false
SCRAPER_MAX_PAGES=25
SCRAPER_VERIFY_REMOVED_BATCH=250
SCRAPER_INTERVAL_MINUTES=240
SCRAPER_RUN_ONCE=false

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ZTPGHSG9DN
